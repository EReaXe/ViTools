{
  "manifest_version": 3,
  "name": "ViTools",
  "version": "0.1.1",
  "description": "YouTube için video, MP3, küçük resim, altyazı ve ekran görüntüsü araçları. Açık kaynak deneme sürümü.",
  "permissions": ["storage", "downloads", "scripting", "alarms"],
  "host_permissions": ["https://www.youtube.com/*", "https://api.github.com/repos/EReaXe/ViTools/releases/latest"],
  "background": {"service_worker": "background.js", "type": "module"},
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["caption-observer.js"],
    "world": "MAIN",
    "run_at": "document_start"
  }, {
    "matches": ["https://www.youtube.com/*"],
    "js": ["subtitles.js", "content.js"],
    "run_at": "document_idle"
  }],
  "action": {"default_popup": "popup.html", "default_title": "ViTools"},
  "web_accessible_resources": [{"resources": ["mux.js", "sabr.js", "audio.js", "vendor/lamejs.js", "vendor/mediabunny.mjs", "vendor/googlevideo.mjs"], "matches": ["https://www.youtube.com/*"]}]
}

